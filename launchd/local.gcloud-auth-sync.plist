<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>local.gcloud-auth-sync</string>
  <key>ProgramArguments</key>
  <array><string>@DOTFILES@/launchd/gcloud-auth-sync</string></array>
  <key>WatchPaths</key>
  <array><string>@HOME@/.config/gcloud/credentials.db</string></array>
  <key>StartInterval</key><integer>600</integer>
</dict>
</plist>
